{
  "name": "distinctive-audio",
  "version": "1.0.0",
  "private": true,
  "description": "Distinctive Audio — Ottawa high-end audio store static site",
  "scripts": {
    "build": "vite build",
    "build:site": "node build-site.mjs",
    "dev": "npm run build:site && python3 -m http.server 8000 --directory _site",
    "watch": "tailwindcss -i ./src/input.css -o ./css/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "vite": "^8.1.0"
  }
}
