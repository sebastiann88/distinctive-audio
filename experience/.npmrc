# threepipe peer-depends on its own three.js FORK (a pkg.threepipe.org
# tarball), which conflicts with this project's regular `three` dependency.
# The conflict is harmless — threepipe's dist bundle embeds its fork, and
# vite.config.js aliases 'threepipe' to that bundle — but strict peer
# resolution would fail every `npm install` without this.
legacy-peer-deps=true
